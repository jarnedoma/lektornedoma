# Databáze – lokálně SQLite soubor, v produkci např. Turso (libsql://...)
DATABASE_URL=file:./data/lektornedoma.db
DATABASE_AUTH_TOKEN=

# Přihlášení do administrace (/admin)
ADMIN_EMAIL=skoleni@lektornedoma.cz
# Hash hesla vygenerujte: node scripts/hash-password.mjs "VaseHeslo" (vypíše celý řádek k vložení)
ADMIN_PASSWORD_HASH=
# Náhodný dlouhý řetězec (min. 32 znaků) pro podepisování session cookie
AUTH_SECRET=

# Volitelné: e-mailové notifikace o nových poptávkách/objednávkách/rezervacích
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=web@lektornedoma.cz
NOTIFY_TO=skoleni@lektornedoma.cz

# Veřejná adresa webu (pro odkazy v e-mailech, sitemap)
SITE_URL=https://www.lektornedoma.cz
